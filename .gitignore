.template-sync.local
.claude/settings.local.json
pitch-log/

# Python bytecode caches from the helper scripts in scripts/
__pycache__/
*.pyc

# uv-managed virtual environment
.venv/

# Private workshop: scratch notes for building the homebrew campaign.
# Never committed — drafts, session-building notes, character/lore sketches
# live here until they graduate into data/ or scheduler/ on a real branch.
workshop/
questionnaires/*
!questionnaires/.gitkeep
vector-index/
tasks/*

# No map images in git. Masters are fetched from the Inkarnate CDN
# (scripts/fetch-maps.ps1, manifest maps/sources.tsv, committed); tiles and crops are
# generated locally (scripts/gen-tiles.py, scripts/map-crop.ps1). Cold-start sequence:
# fetch-maps.ps1 -> gen-tiles.py.
maps/**/*.png
maps/**/*.webp
maps/**/*.jpg
maps/**/*.jpeg
maps/**/*.gif
# Battlemap layouts (scripts/battlemap.py input) are local reference for planning talk,
# not record -- the session plan carries the grid refs that matter.
scheduler/**/maps/*.txt
historian/**/maps/*.txt
maps/battlemaps/**/*.txt
!maps/battlemaps/tokens-common.txt
!maps/battlemaps/tokens-uploaded.txt
# Purchased Roll20 / VTT asset packs (Forgotten Adventures etc.) -- licensed, multi-GB.
maps/roll20 assets/
app/node_modules
# Session recordings. Audio is large and binary -- it stays on the DM's machine; the
# transcript in recaps/transcripts/ is the committed record of what was said.
# .cache/ holds per-track JSON so a rerun re-merges without re-transcribing (regenerable).
# Directories are re-included first: git cannot un-ignore a file inside an excluded
# directory, so `!recaps/audio/**/` is what lets the speakers.tsv rule below apply.
recaps/audio/**
!recaps/audio/**/
!recaps/audio/.gitkeep
# speakers.tsv is config, not audio -- the handle-to-name map is worth keeping.
!recaps/audio/**/speakers.tsv
recaps/transcripts/.cache/
# Craig download bundles, in case one lands in the repo root before it is unpacked.
craig-*.zip
# Downloaded model weights (ECAPA speaker embeddings for diarize-track.py). Fetched on
# first run, same as the Whisper model -- rebuilt from upstream, never committed.
.models/
