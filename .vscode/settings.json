{
  "foam.links.sync.enable": true,

  "foam.graph.style": {
    "background": "#1e1e2e",
    "edge": "#444466",
    "node.note": "#666688",
    "node.placeholder": "#993333",
    "node.feature": "#ffffff"
  },

  "foam.graph.views": [
    {
      "name": "Default",
      "colorBy": "none",
      "groups": [
        { "id": "classes",          "label": "Classes",           "match": { "property": "path", "value": "data/classes" },              "color": "#ce93d8", "enabled": true },
        { "id": "races",            "label": "Races",             "match": { "property": "path", "value": "data/races" },                "color": "#4dd0e1", "enabled": true },
        { "id": "deities",          "label": "Deities",           "match": { "property": "path", "value": "data/deities" },              "color": "#ffd54f", "enabled": true },
        { "id": "npcs",             "label": "NPCs",              "match": { "property": "path", "value": "data/characters" },           "color": "#ff8a65", "enabled": true },
        { "id": "pcs",              "label": "PCs",               "match": { "property": "path", "value": "data/characters/pcs" },       "color": "#ef5350", "enabled": true },
        { "id": "creatures",        "label": "Creatures",         "match": { "property": "path", "value": "data/creatures" },            "color": "#9ccc65", "enabled": true },
        { "id": "factions",         "label": "Factions",          "match": { "property": "path", "value": "data/factions" },             "color": "#ab47bc", "enabled": true },
        { "id": "locations",        "label": "Locations",         "match": { "property": "path", "value": "data/locations" },            "color": "#66bb6a", "enabled": true },
        { "id": "items",            "label": "Items",             "match": { "property": "path", "value": "data/items" },                "color": "#ffa726", "enabled": true },
        { "id": "magic-items",      "label": "Magic Items",       "match": { "property": "path", "value": "data/items/magic" },          "color": "#26c6da", "enabled": true },
        { "id": "events",           "label": "Events",            "match": { "property": "path", "value": "data/events" },               "color": "#ec407a", "enabled": true },
        { "id": "rumors",           "label": "Rumors",            "match": { "property": "path", "value": "data/rumors" },               "color": "#78909c", "enabled": true },
        { "id": "h-classes",        "label": "Classes (canon)",   "match": { "property": "path", "value": "historian/classes" },         "color": "#ce93d8", "enabled": true },
        { "id": "h-deities",        "label": "Deities (canon)",   "match": { "property": "path", "value": "historian/deities" },         "color": "#ffd54f", "enabled": true },
        { "id": "h-npcs",           "label": "NPCs (canon)",      "match": { "property": "path", "value": "historian/characters" },      "color": "#ff8a65", "enabled": true },
        { "id": "h-pcs",            "label": "PCs (canon)",       "match": { "property": "path", "value": "historian/characters/pcs" },  "color": "#ef5350", "enabled": true },
        { "id": "h-creatures",      "label": "Creatures (canon)", "match": { "property": "path", "value": "historian/creatures" },       "color": "#9ccc65", "enabled": true },
        { "id": "h-factions",       "label": "Factions (canon)",  "match": { "property": "path", "value": "historian/factions" },        "color": "#ab47bc", "enabled": true },
        { "id": "h-locations",      "label": "Locations (canon)", "match": { "property": "path", "value": "historian/locations" },       "color": "#66bb6a", "enabled": true },
        { "id": "h-items",          "label": "Items (canon)",     "match": { "property": "path", "value": "historian/items" },           "color": "#ffa726", "enabled": true },
        { "id": "h-magic-items",    "label": "Magic Items (canon)","match": { "property": "path", "value": "historian/items/magic" },    "color": "#26c6da", "enabled": true },
        { "id": "h-events",         "label": "Events (canon)",    "match": { "property": "path", "value": "historian/events" },          "color": "#ec407a", "enabled": true },
        { "id": "sessions",         "label": "Sessions",          "match": { "property": "path", "value": "historian/sessions" },        "color": "#ffca28", "enabled": true },
        { "id": "h-missions",       "label": "Missions (done)",   "match": { "property": "path", "value": "historian/missions" },        "color": "#ff8f00", "enabled": true },
        { "id": "scheduler",        "label": "Scheduler",         "match": { "property": "path", "value": "scheduler" },                 "color": "#d4e157", "enabled": true },
        { "id": "acts",             "label": "Acts",              "match": { "property": "path", "value": "scheduler/acts" },            "color": "#e040fb", "enabled": true },
        { "id": "missions",         "label": "Missions (active)", "match": { "property": "path", "value": "scheduler/missions" },        "color": "#ff6d00", "enabled": true },
        { "id": "campaign",         "label": "Campaign",          "match": { "property": "path", "value": "scheduler/campaign" },        "color": "#ff3d00", "enabled": true },
        { "id": "meta",             "label": "Meta",              "match": { "property": "path", "value": "meta" },                      "color": "#90a4ae", "enabled": true }
      ]
    },
    {
      "name": "Canon vs Free",
      "colorBy": "none",
      "groups": [
        { "id": "free",      "label": "Free (data)",      "match": { "property": "path", "value": "data" },      "color": "#888888", "enabled": true },
        { "id": "canon",     "label": "Canon (historian)","match": { "property": "path", "value": "historian" }, "color": "#4fc3f7", "enabled": true },
        { "id": "active",    "label": "Active (scheduler)","match": { "property": "path", "value": "scheduler" }, "color": "#aed581", "enabled": true },
        { "id": "meta",      "label": "Meta",             "match": { "property": "path", "value": "meta" },      "color": "#90a4ae", "enabled": true }
      ]
    }
  ]
}
