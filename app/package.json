    "happy-dom": "^20.10.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "jeff-ui": "github:JGarnerDev/jeff-ui-project#v0.1.0",
