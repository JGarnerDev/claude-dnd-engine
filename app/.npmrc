# jeff-ui is the private package @jgarnerdev/jeff-ui on GitHub Packages.
# Installing it needs a GitHub token with read:packages in your own npm
# config (never here); see the README.
@jgarnerdev:registry=https://npm.pkg.github.com
# npm 12 refuses tarball URLs by default, and the jeff-ui alias resolves to
# one; allow URLs reached from this package.json, and only those.
allow-remote=root
